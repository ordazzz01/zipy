{
  "name": "Zipy",
  "version": "1.0.0",
  "description": "Zipy — Plataforma de delivery local on-demand",
  "scripts": {
    "dev": "pnpm --filter @zipy/customer-web dev",
    "build": "pnpm --filter @zipy/customer-web build",
    "lint": "pnpm --filter @zipy/customer-web lint",
    "typecheck": "pnpm --filter @zipy/customer-web typecheck",
    "seed": "npx tsx seed/scripts/seed.ts",
    "seed:clean": "npx tsx seed/scripts/clean.ts",
    "seed:reset": "npx tsx seed/scripts/clean.ts && npx tsx seed/scripts/seed.ts",
    "emulators": "cd functions && npx firebase emulators:start --project=zipy-dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  }
}
