rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: lee el rol desde el documento del usuario en Firestore
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Users: acceso total a su propio perfil
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /addresses/{addrId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Merchants: lectura pública
    // Escritura: solo merchant owner (document.ownerId == uid) o admin (por rol en /users/{uid})
    match /merchants/{merchantId} {
      allow read: if true;
      allow write: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        getUserRole() == 'admin'
      );

      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && getUserRole() == 'admin';
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if request.auth != null && getUserRole() == 'admin';
      }

      match /branches/{branchId} {
        allow read: if true;
        allow write: if request.auth != null && getUserRole() == 'admin';
      }
    }

    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        resource.data.merchantId == request.auth.uid ||
        getUserRole() == 'admin'
      );
      allow create: if request.auth != null && getUserRole() == 'customer';
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        getUserRole() == 'admin'
      );
      allow delete: if request.auth != null && getUserRole() == 'admin';
    }

    // Drivers: solo su perfil
    match /drivers/{driverUid} {
      allow read, write: if request.auth != null && request.auth.uid == driverUid;
      allow read, write: if request.auth != null && getUserRole() == 'admin';
    }

    // Coupons: lectura pública, escritura admin
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

    // Catch-all: denegar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
